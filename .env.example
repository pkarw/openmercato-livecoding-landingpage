# Copy this file to .env and fill in the secrets. Neither .env nor .env.local is committed.
# Real environment variables always win, and .env.local wins over .env.

# Local development defaults (sandbox PostgreSQL and Redis).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/open-mercato
REDIS_URL=redis://:redis-dev-password@127.0.0.1:6379/1
CACHE_TTL_SECONDS=30

# HTTP port for the single ASP.NET Core process (API + React app).
PORT=3000

# Limited-time offer: -15% until the end of Sunday 20.09 (Warsaw time).
OFFER_DISCOUNT_PERCENT=15
OFFER_ENDS_AT=2026-09-20T23:59:59+02:00

# Resend delivery: the code goes to the lead, a copy of every new lead goes to LEADS_INBOX.
# ADMIN_EMAIL must live on a domain verified in Resend.
# Create a key at https://resend.com/api-keys and keep it out of version control.
RESEND_API_KEY=
ADMIN_EMAIL=info@updates.openmercato.com
LEADS_INBOX=info@openmercato.com
