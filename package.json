    "db:setup": "node scripts/db.mjs migrate && node scripts/db.mjs seed"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "next": "^16.3.5",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
