{
  "name": "open-mercato-custom-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start -H 0.0.0.0 -p 3000",
    "db:migrate": "node scripts/db.mjs migrate",
